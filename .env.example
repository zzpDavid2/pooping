# 复制成 .env.local 再填。所有连接配置走 env，代码里不写死（CLAUDE.md 8.5）。

# ---- Supabase ----
# 本地开发：跑 `pnpm db:start`，把它输出的 API URL 和 anon key 填这儿
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ---- 地区 / 语言 ----
# cn = 高德瓦片 + GCJ-02 偏移；intl = 海外瓦片
# 现阶段先跑国内版（在北京/上海实测），所以默认 cn
VITE_DEFAULT_REGION=cn
# zh | en，留空则跟浏览器语言
VITE_DEFAULT_LOCALE=zh

# ---- 地图瓦片 ----
# 高德默认用内置的 webrd01-04 子域轮询，一般不用填
# VITE_AMAP_TILE_URL=

# 海外底图。不填的话 intl 模式只显示标记点，没有底图
# VITE_TILE_URL_INTL=https://example.com/tiles/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# VITE_MAPTILER_KEY=

# ================================================================
# 下面这些**不进前端**，只给 scripts/ 和 Edge Function 用。
# LLM 的 key 绝不能加 VITE_ 前缀，那会被打进 bundle 里公开出去。
# ================================================================

# scripts/import-osm.ts 和 scripts/seed-reviews.ts 要用 service_role 写库
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function 的环境变量，用 `supabase secrets set` 设到云端，
# 本地则放在 supabase/functions/.env（那个文件已在 .gitignore 里）
#
# LLM_PROVIDER=dashscope          # anthropic | openai | dashscope（阿里云百炼）
#
# ---- 阿里云百炼（DeepSeek）----
# 服务在境内，从北京/上海调延迟低、不用翻墙，跟「先跑国内版」是一路的
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# base_url 现在按工作空间+地域分，去控制台「工作空间详情」拿 WorkspaceId。
# 老地址 https://dashscope.aliyuncs.com/compatible-mode/v1 目前也仍然可用。
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#
# ⚠ 不要用 deepseek-r1：推理模型不接受 temperature，而这个产品就靠 1.25 出效果
# ⚠ deepseek-v3 / v3.1 / r1 官方公告 2026-10-10 下线，别拿它们起新项目
# DASHSCOPE_MODEL=deepseek-v3.2
#
# ---- 其它 ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                # 填了就能指向任何 OpenAI 兼容网关
